package lesson_4.taskpostcomment;
import java.util.Arrays;
public class PostComment {

    public void setText(String text) {
        this.text = text;
    }

    public void setWhoLiked(String[] whoLiked) {
        this.whoLiked = whoLiked;
    }
    private String text; // содержание комментария
    private String[] whoLiked; // кто поддержал
    public String getText() {
        return text;
    }

    public String[] getWhoLiked() {
        return whoLiked;
    }
    
    @Override
    public String toString(){
        String getWhoLikedStr = null;
        if(getWhoLiked() != null){
            getWhoLikedStr = Arrays.toString(getWhoLiked());
        }
        return ("text:" + text + "; getWhoLiked: " + getWhoLikedStr);
    }
    
    
    
}

